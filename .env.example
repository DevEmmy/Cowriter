# Any Postgres. Free options: Supabase (supabase.com) or Neon (neon.tech)
DATABASE_URL=
# Only if your database provider uses its own certificate authority (PEM text)
# DATABASE_CA=
# 32+ random characters: openssl rand -base64 48
AUTH_SECRET=
# AI (free): Google AI Studio key from https://aistudio.google.com/apikey (starts with "AIza")
GEMINI_API_KEY=
# Optional model override
# GEMINI_MODEL=gemini-2.5-flash
# Optional free fallback provider: set AI_PROVIDER=groq and GROQ_API_KEY from https://console.groq.com
# AI_PROVIDER=
# GROQ_API_KEY=

# Optional third-party AI-text detectors (Chapter Analyser). Leave empty to keep the feature off; Co Writer never invents scores.
GPTZERO_API_KEY=
ORIGINALITY_API_KEY=
